<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>

<BorderPane style="-fx-background-color: darkblue;" styleClass="background" stylesheets="@../../../../sae.css" xmlns="http://javafx.com/javafx/8.0.40" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.sae.Controleur">
    <top>
        <Label styleClass="label-header" text=" Scorer Defense" textFill="WHITE" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="10.0" top="10.0" />
            </padding>
        </Label>
    </top>
    <bottom>
        <HBox style="-fx-background-color: darkblue;" styleClass="encadre" BorderPane.alignment="CENTER">
            <children>
            <VBox prefHeight="234.0" prefWidth="154.0" />
                <VBox fx:id="pvVbox" alignment="CENTER" prefHeight="234.0" prefWidth="356.0">
                    <children>
                        <ImageView fx:id="coeursVieImageView" fitHeight="164.0" fitWidth="128" preserveRatio="true" />
                    </children>
                </VBox>
                <VBox fx:id="piecesVbox" alignment="CENTER" prefHeight="201.0" prefWidth="128.0">
                    <children>
                          <ImageView fx:id="coinImageView" fitHeight="104.0" fitWidth="128.0" preserveRatio="true" />

                                            <Label fx:id="piecesLabel" alignment="TOP_CENTER" prefHeight="32" prefWidth="128" text="120" textFill="WHITE" />
                    </children>
                </VBox>
                <VBox fx:id="vaguesVbox" alignment="CENTER" prefHeight="200.0" prefWidth="165.0">
                    <children>
                        <Label text="nombre de vague" textFill="WHITE" />
                        <Label fx:id="vagueLabel" prefHeight="31.0" prefWidth="93.0" style="-fx-border-color: red;" text="0" textFill="WHITE" />
                    </children>
                </VBox>
            <VBox fx:id="testBox" alignment="CENTER" prefHeight="234.0" prefWidth="163.0">
                <children>
                    <Button onAction="#spawnerEnnemi" prefWidth="200.0" style="-fx-background-color: red;" text="Spawner ennemi" />
                </children>

            </VBox>
            </children>
        </HBox>
    </bottom>
    <center>
        <Pane id="paneJeu" fx:id="paneJeu" maxHeight="672.0" maxWidth="1120.0" minHeight="672.0" minWidth="1120.0" prefHeight="672.0" prefWidth="1120.0" BorderPane.alignment="CENTER">
        </Pane>
    </center>
   <right>
      <VBox fx:id="hboxTours" alignment="TOP_CENTER" prefHeight="200.0" prefWidth="130.0" spacing="10" style="-fx-background-color: darkblue;" BorderPane.alignment="CENTER">
         <padding>
            <Insets left="5.0" right="5.0" top="10.0" />
         </padding>
         <children>
            <Label text="Tours" textFill="WHITE" />
            <Label fx:id="selectionLabel" prefWidth="120.0" style="-fx-font-size: 10px; -fx-text-fill: #aaa;" text="Cliquez sur une case" textFill="WHITE" wrapText="true" />
            <Button onAction="#ajouterTour" prefWidth="120.0" style="-fx-background-color: #3a7d44;" text="Shifty" />
            <Button onAction="#ajouterTour" prefWidth="120.0" style="-fx-background-color: #3a7d44;" text="Shooter" />
            <Button onAction="#ajouterTour" prefWidth="120.0" style="-fx-background-color: #3a7d44;" text="Zoner" />
            <Button onAction="#ajouterTour" prefWidth="120.0" style="-fx-background-color: #3a7d44;" text="Ralentisseur" />
            <Button onAction="#ajouterTour" prefWidth="120.0" style="-fx-background-color: #3a7d44;" text="Laser" />
            <Button onAction="#ajouterTour" prefWidth="120.0" style="-fx-background-color: #3a7d44;" text="Canonner" />
         </children>
      </VBox>
   </right>
   <left>
      <VBox prefHeight="993.0" prefWidth="109.0" style="-fx-background-color: darkblue;" BorderPane.alignment="CENTER">
         <children>
             <Button fx:id="boutonVitesseJeu" alignment="CENTER" mnemonicParsing="false" onAction="#changerVitesseJeu" text="x1" />
         </children>
      </VBox>
   </left>
</BorderPane>
