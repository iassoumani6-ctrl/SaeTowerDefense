<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane styleClass="background" stylesheets="@../../../../sae.css" xmlns="http://javafx.com/javafx/8.0.40" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.sae.Controleur">
    <top>
        <Label styleClass="label-header" text=" Scorer Defense" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="10.0" top="10.0" />
            </padding>
        </Label>
    </top>
    <bottom>
        <HBox style="-fx-background-color: black;" styleClass="encadre" BorderPane.alignment="CENTER">
            <children>
            <VBox fx:id="pvVbox" alignment="CENTER" prefHeight="200.0" prefWidth="100.0">
               <children>
                  <Label alignment="CENTER" prefHeight="16.0" prefWidth="64.0" text="pv" textFill="WHITE" />
                  <Label fx:id="pvLabel" alignment="CENTER" prefHeight="16.0" prefWidth="64.0" style="-fx-border-color: red;" text="150" textFill="WHITE" />
               </children>
            </VBox>
            <VBox fx:id="piècesVbox" alignment="CENTER" prefHeight="200.0" prefWidth="100.0">
               <children>
                  <Label text="piècesExemple" textFill="WHITE" />
                  <Label fx:id="piècesLabel" style="-fx-border-color: red;" text="100" textFill="WHITE" />
               </children>
            </VBox>
                <VBox fx:id="vaguesVbox" alignment="CENTER" prefHeight="100.0" prefWidth="150.0">
                    <children>
                        <Label text="nombre de vague" textFill="WHITE" />
                        <Label prefHeight="31.0" prefWidth="93.0" style="-fx-border-color: red;" text="0" textFill="WHITE" />
                    </children>
                </VBox>
            </children>
        </HBox>
    </bottom>
    <center>
        <Pane id="paneJeu" fx:id="paneJeu"
              prefWidth="1120.0" prefHeight="672.0"
              minWidth="1120.0" minHeight="672.0"
              maxWidth="1120.0" maxHeight="672.0"
              BorderPane.alignment="CENTER">
        </Pane>
    </center>
   <right>
      <VBox fx:id="hboxTours" alignment="TOP_CENTER" prefHeight="200.0" prefWidth="130.0"
            style="-fx-background-color: black;" spacing="10" BorderPane.alignment="CENTER">
         <padding>
            <Insets top="10.0" left="5.0" right="5.0" />
         </padding>
         <children>
            <Label text="tours" textFill="WHITE" />
            <Label fx:id="selectionLabel"
                   text="Cliquez sur une case"
                   textFill="WHITE"
                   wrapText="true"
                   prefWidth="120.0"
                   style="-fx-font-size: 10px; -fx-text-fill: #aaa;" />
            <Button text="+ Placer la tour ici"
                    onAction="#ajouterTour"
                    style="-fx-background-color: #3a7d44; -fx-text-fill: white; -fx-font-size: 11px; -fx-cursor: hand;"
                    prefWidth="120.0" />
            <Button text="&#128472; Spawner ennemi"
                    onAction="#spawnerEnnemi"
                    style="-fx-background-color: red;"
                    prefWidth="120.0" />
         </children>
      </VBox>
   </right>
</BorderPane>
